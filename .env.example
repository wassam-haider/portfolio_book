# Copy to .env and fill in values.

# ----- Database (Neon Postgres) -----
# Create a free database at https://neon.tech (or via the Vercel Marketplace ->
# Neon integration, which sets DATABASE_URL automatically on Vercel).
# Use the POOLED connection string (host contains "-pooler") for serverless.
# pgbouncer=true tells Prisma to skip server-side prepared statements, which
# Neon's PgBouncer-fronted pooler needs (without it, concurrent/rapid queries
# intermittently fail with "prepared statement already exists").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# ----- Admin dashboard authentication -----
ADMIN_EMAIL="you@example.com"
# Password used to sign in at /admin/login. Use a strong value in production.
ADMIN_PASSWORD=""
# Random 32+ char secret used to sign session tokens (e.g. `openssl rand -hex 32`).
AUTH_SECRET=""

# ----- S.H.E.A. assistant (LLM via OpenRouter) -----
# Get a key at https://openrouter.ai/keys. If empty, the chat UI still works
# but S.H.E.A. explains that the assistant is not configured yet.
OPENROUTER_API_KEY=""
# Any OpenRouter model id works (https://openrouter.ai/models).
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# ----- Embeddings for RAG retrieval -----
# "voyage"  -> Voyage AI embeddings (https://www.voyageai.com), set EMBEDDING_API_KEY, model e.g. voyage-3.5-lite
# "openai"  -> OpenAI embeddings, set EMBEDDING_API_KEY, model e.g. text-embedding-3-small
# "lexical" -> no API key needed; keyword-based retrieval over the knowledge base (works offline)
EMBEDDING_PROVIDER="lexical"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL=""

# ----- File uploads (screenshots / demo videos) -----
# On Vercel: add the Blob store in the Vercel dashboard; this token is set automatically.
# Locally: leave empty to save uploads to public/uploads instead.
BLOB_READ_WRITE_TOKEN=""
